  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "if (!pm.environment.get(\"authToken\")) {\r",
          "    pm.sendRequest({\r",
          "        url: pm.environment.get(\"baseUrl\") + \"/api/v1/auth/login\",\r",
          "        method: \"POST\",\r",
          "        header: { \"Content-Type\": \"application/json\" },\r",
          "        body: {\r",
          "            mode: \"raw\",\r",
          "            raw: JSON.stringify({\r",
          "                email: \"storeadmin@electropi.com\",\r",
          "                password: \"Admin@123\"\r",
          "            })\r",
          "        }\r",
          "    }, function (err, res) {\r",
          "        if (!err) {\r",
          "            const jsonRes = res.json();\r",
          "            pm.environment.set(\"authToken\", jsonRes.token);\r",
          "        }\r",
          "    });\r",
          "}"
        ]
      }
    },
