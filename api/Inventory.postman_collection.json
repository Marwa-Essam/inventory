      "name": "POSITIVE",
      "item": [
        {
          "name": "Create Item - Valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const responseBody = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code is 201 Created\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains correct SKU\", function () {\r",
                  "    pm.expect(responseBody.sku).to.eql(\"MS-001\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains item_id\", function () {\r",
                  "    pm.expect(responseBody).to.have.property(\"item_id\");\r",
                  "});\r",
                  "\r",
                  "if (responseBody.item_id !== undefined) {\r",
                  "    pm.environment.set(\"createdItemId\", responseBody.item_id);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
